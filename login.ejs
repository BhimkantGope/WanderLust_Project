<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <h3 class="col-6 offset-3">LogIn</h3>
    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input id="username" name="username" placeholder="Enter your username" type="text" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" placeholder="Enter your password" type="password" class="form-control" required>
            </div>
            <button class="btn btn-success edit-btn">Login</button>
        </form>
    </div> 
</div>